*~

# A collection of .gitignore templates
# https://github.com/github/gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
venv/

/eyedrop.db

# 本番データのコピー(開発・テスト用。非公開)
# 公開用のデータは精査して別途作成する
*.ods

# スマホ版(Flet)のビルド生成物
mobile/build/

# Android の署名の鍵(公開用の keystore)。絶対にコミットしない。保存先はリポジトリの外(~/keys/)
*.jks
*.keystore

# Sphinx の作業用ビルド(公開用の HTML は docs/ に出力してコミットする)
document/_build/
